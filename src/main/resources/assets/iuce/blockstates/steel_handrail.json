        "formed": "false",
        "south": "true"
      },
      "apply": {
        "model": "iuce:block/steel_handrail_side",
        "uvlock": true,
        "y": 180
      }
    },
    {
      "when": {
        "formed": "false",
        "west": "true"
      },
      "apply": {
        "model": "iuce:block/steel_handrail_side",
        "uvlock": true,
        "y": 270
      }
    }
