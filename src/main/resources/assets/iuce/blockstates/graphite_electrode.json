{
  "multipart": [
    {
      "when": {
        "formed": "false",
        "axis": "y"
      },
      "apply": {
        "model": "iuce:block/graphite_electrode"
      }
    },
    {
      "when": {
        "formed": "false",
        "axis": "z"
      },
      "apply": {
        "model": "iuce:block/graphite_electrode",
        "x": 90
      }
    },
    {
      "when": {
        "formed": "false",
        "axis": "x"
      },
      "apply": {
        "model": "iuce:block/graphite_electrode",
        "x": 90,
        "y": 90
      }
    }
  ]
}
