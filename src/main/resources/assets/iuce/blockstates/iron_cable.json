{
  "multipart": [
    { "apply": { "model": "iuce:block/cable/iron_cable_core" } },
    { "when": { "north": "true" }, "apply": { "model": "iuce:block/cable/iron_cable_side", "uvlock": true } },
    { "when": { "east": "true" },  "apply": { "model": "iuce:block/cable/iron_cable_side", "uvlock": true, "y": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "iuce:block/cable/iron_cable_side", "uvlock": true, "y": 180 } },
    { "when": { "west": "true" },  "apply": { "model": "iuce:block/cable/iron_cable_side", "uvlock": true, "y": 270 } },
    { "when": { "up": "true" },    "apply": { "model": "iuce:block/cable/iron_cable_side", "uvlock": true, "x": -90 } },
    { "when": { "down": "true" },  "apply": { "model": "iuce:block/cable/iron_cable_side", "uvlock": true, "x": 90 } }
  ]
}
